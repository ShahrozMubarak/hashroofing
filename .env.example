NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DB_NAME=auren_roofing

JWT_ACCESS_SECRET=replace_with_strong_random_access_secret_key
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30

CLIENT_ORIGIN=https://your-auren-domain.vercel.app
COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

SEED_OWNER_NAME="Auren Managing Partner"
SEED_OWNER_EMAIL=admin@aurenroofing.co
SEED_OWNER_PASSWORD=replace_with_strong_owner_password

RESEND_API_KEY=re_your_resend_api_key
CONTACT_RECIPIENT_EMAIL=owner@your-verified-domain.com
RESEND_FROM_EMAIL="Auren Roofing <onboarding@resend.dev>"

