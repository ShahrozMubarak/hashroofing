{
  "name": "auren-roofing-co",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Auren Roofing Co. — Architectural Residential Roofing & Engineering Platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --config client/vite.config.js",
    "dev:server": "tsx watch server/src/dev.ts",
    "build": "vite build --config client/vite.config.js",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node server/dist/server.js",
    "db:seed": "tsx server/src/scripts/seed.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^14.14.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lenis": "^1.3.29",
    "lucide-react": "^0.460.0",
    "mongoose": "^8.9.5",
    "pdfkit": "^0.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.7",
    "@types/pdfkit": "^0.13.7",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "mongodb-memory-server": "^10.1.4",
    "concurrently": "^9.2.5",
    "postcss": "^8.4.47",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.4"
  }
}

